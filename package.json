{
  "name": "geospatial-catalog-service",
  "version": "1.0.0",
  "description": "Geospatial Catalog API, structured after MapColonies' ts-server-boilerplate",
  "main": "./src/index.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:openapi": "redocly lint openapi3.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean && npm run generate:openapi-types",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles -f ./openapi3.yaml ./dist/ && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "generate:openapi-types": "openapi-generators generate types ./openapi3.yaml ./src/openapi.d.ts --format --add-typed-request-handler",
    "db:migrate": "cross-env NODE_ENV=development tsx src/common/db/migrate.ts latest",
    "db:migrate:rollback": "cross-env NODE_ENV=development tsx src/common/db/migrate.ts rollback",
    "test:migrate": "cross-env NODE_ENV=test tsx src/common/db/migrate.ts latest",
    "test:migrate:rollback": "cross-env NODE_ENV=test tsx src/common/db/migrate.ts rollback",
    "test:db:up": "docker compose up -d postgres-test",
    "test:db:down": "docker compose down",
    "docker:build": "docker build -t geospatial-catalog-service:latest .",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/error-express-handler": "^4.0.0",
    "@map-colonies/express-access-log-middleware": "^5.0.0",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/openapi-express-viewer": "^5.0.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^2.0.0",
    "@map-colonies/schemas": "^1.24.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.6.2",
    "http-status-codes": "^2.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/eslint-plugin": "^1.0.0",
    "@map-colonies/openapi-express-types": "^0.2.0",
    "@map-colonies/openapi-generators": "^0.2.0",
    "@map-colonies/openapi-supertest": "^0.2.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@map-colonies/tsconfig": "^2.0.0",
    "@redocly/cli": "^2.39.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vitest/ui": "^4.1.8",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jest-openapi": "^0.14.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix",
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml}": "prettier --write"
  }
}
