    {
      "name": "Products / Search - Numeric Comparisons",
      "item": [
        {
          "name": "Resolution Best Greater Than (greater)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?resolution_best_gt=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "resolution_best_gt",
                  "value": "5"
                }
              ]
            },
            "description": "Returns products whose `resolution_best` is greater than 5 (strictly greater — the `greater` operator, `resolution_best_gt`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All returned products have resolution_best > 5\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach((p) => pm.expect(p.resolution_best).to.be.above(5));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolution Best Greater Or Equal (greaterEqual)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?resolution_best_gte=0.15",
