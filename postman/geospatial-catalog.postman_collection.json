{
  "info": {
    "name": "Geospatial Products Catalog API",
    "description": "Demonstrates the CRUD and advanced filtering (equality, numeric comparison, combined, and spatial WKT) capabilities of the Geospatial Products Catalog REST API, built with Express and Postgres/PostGIS. Includes a liveness health check outside the /api/v1 prefix.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness probe for the service. Lives outside the /api/v1 prefix and simply returns {\"status\":\"ok\"} when the service is up."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body reports ok status\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products / CRUD",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Creates a new geospatial product. On success, the response body (containing the generated `id`) is captured and stored in the `productId` collection variable so the Get/Update/Delete-by-id requests below can be run right after this one (e.g. via Collection Runner) and automatically operate on the newly created product.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tel Aviv Orthophoto 2024\",\n  \"description\": \"High-resolution aerial orthophoto covering the Tel Aviv metropolitan area, captured in spring 2024.\",\n  \"type\": \"raster\",\n  \"consumption_protocol\": \"WMTS\",\n  \"consumption_link\": \"https://tiles.example.com/tel-aviv-orthophoto/{z}/{x}/{y}.png\",\n  \"resolution_best\": 0.15,\n  \"min_zoom\": 10,\n  \"max_zoom\": 19,\n  \"bounding_polygon\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [\n          34.75,\n          32\n        ],\n        [\n          34.85,\n          32\n        ],\n        [\n          34.85,\n          32.15\n        ],\n        [\n          34.75,\n          32.15\n        ],\n        [\n          34.75,\n          32\n        ]\n      ]\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains an id and matches the created name\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.name).to.eql(\"Tel Aviv Orthophoto 2024\");",
                  "    pm.collectionVariables.set(\"productId\", jsonData.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Fetches a single product by its UUID. Uses the `{{productId}}` collection variable, which is populated automatically by the \"Create Product\" request when run beforehand."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has an id field\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Replaces an existing product identified by `{{productId}}` with a new representation (full update, same shape as create). Demonstrates PUT /products/{id}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tel Aviv Orthophoto 2024 (Reprocessed)\",\n  \"description\": \"Reprocessed high-resolution aerial orthophoto covering the Tel Aviv metropolitan area, with improved color balancing.\",\n  \"type\": \"raster\",\n  \"consumption_protocol\": \"WMTS\",\n  \"consumption_link\": \"https://tiles.example.com/tel-aviv-orthophoto-v2/{z}/{x}/{y}.png\",\n  \"resolution_best\": 0.12,\n  \"min_zoom\": 10,\n  \"max_zoom\": 20,\n  \"bounding_polygon\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [\n          34.75,\n          32\n        ],\n        [\n          34.85,\n          32\n        ],\n        [\n          34.85,\n          32.15\n        ],\n        [\n          34.75,\n          32.15\n        ],\n        [\n          34.75,\n          32\n        ]\n      ]\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response reflects updated name\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Tel Aviv Orthophoto 2024 (Reprocessed)\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Deletes the product identified by `{{productId}}`. Returns 204 No Content on success and 404 if the product does not exist."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products / Search - Equality",
      "item": [
