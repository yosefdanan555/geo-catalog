    {
      "name": "Products / Search - Combined Filters",
      "item": [
        {
          "name": "Type + Resolution Best (combined, ANDed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?type=raster&resolution_best_lte=0.2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "raster"
                },
                {
                  "key": "resolution_best_lte",
                  "value": "0.2"
                }
              ]
            },
            "description": "Returns products of type `raster` AND whose `resolution_best` is less than or equal to 0.2. Demonstrates that multiple query parameters are combined with implicit AND logic, as described in the API spec."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All returned products satisfy both filters\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach((p) => {",
                  "        pm.expect(p.type).to.eql(\"raster\");",
                  "        pm.expect(p.resolution_best).to.be.at.most(0.2);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products / Search - Spatial",
